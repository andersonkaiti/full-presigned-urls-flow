{
  "$schema": "https://www.schemastore.org/tsconfig",
  "_version": "24.0.0",
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "module": "nodenext",
    "target": "es2024",

    "esModuleInterop": true,
    "moduleResolution": "node16"
  }
}
